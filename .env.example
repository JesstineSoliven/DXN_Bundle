# Copy to .env.local for local development (never commit real values).
# On Vercel, set these in Project → Settings → Environment Variables.

# Neon Postgres — added automatically when you connect Neon in Vercel → Storage.
# Leave empty locally to use the built-in PGlite database (.data/pglite).
DATABASE_URL=

# Gmail account that sends the emails + its 16-character App Password
# (Google Account → Security → 2-Step Verification → App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Receives "new order" and "GCash payment submitted" emails.
ADMIN_EMAIL=jess1008soliven@gmail.com

# Long random secret for the admin payment controls (until Phase 7 adds admin login).
ADMIN_API_KEY=
